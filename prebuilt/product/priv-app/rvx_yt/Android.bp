android_app_import {
    name: "rvx_yt",
    apk: "rvx_yt.apk",
    preprocessed: true,
    presigned: true,
    product_specific: true,
    skip_preprocessed_apk_checks: true,
    dex_preopt: {
        enabled: false,
    },
}

+cc_prebuilt_library_shared {
+    name: "libelements",
+    owner: "realme",
+    strip: {
+        none: true,
+    },
+    target: {
+        android_arm64: {
+            srcs: [
+                "proprietary/system/lib/libelements.so",
+            ],
+            shared_libs: [
+                "libgoogle3",
+                "libandroid",
+                "liblog",
+                "libdl",
+                "libc",
+                "libm",
+            ],
+        },
+    },
+    compile_multilib: "32",
+    prefer: true,
+    system_ext_specific: true,
+}

